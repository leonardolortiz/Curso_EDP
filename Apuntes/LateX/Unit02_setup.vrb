\frametitle{HALCON - Reglas de Programación}
\begin{itemize}
			\item Iteradores e indexación:
			\begin{itemize}
				\item Para iteradores utilizar \texttt{it}
				\item Para indices siempre usar el tipo \texttt{size\_t} inicializado con \texttt{{ }} (\texttt{size\_t i \{ 0 \}})
				\item Para indices utilizar \texttt{i}, \texttt{j}, \texttt{k}
			\end{itemize}
			\item Números complejos:
			\begin{itemize}
				\item La variable imaginaria con \texttt{j} (evitar \texttt{i})
			\end{itemize}
			\item Librerías:
			\begin{itemize}
				\item Usar librerías estándar dentro de lo posible
				\item Intentar utilizar librerías ya instaladas en el contenedor del proyecto
			\end{itemize}
		\end{itemize}
